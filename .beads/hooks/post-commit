#!/usr/bin/env bash
# Thin shim: bd (beads) owns `core.hooksPath` (set to .beads/hooks by `bd hooks
# install`), but .githooks/ stays the single source of truth for the gates —
# this file must never re-implement or copy them. `bd init` wrote a verbatim
# copy of .githooks/post-commit here, which would have drifted the moment the
# kit's hook changed; delegating instead keeps one definition.
#
# No beads integration block: `bd hooks list` manages pre-commit, post-merge,
# pre-push, post-checkout and prepare-commit-msg — not post-commit.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
exec "$repo_root/.githooks/post-commit" "$@"
