# Copy to /etc/encre/litestream.env (0600, owned by root — Litestream's unit
# runs as root by default to read another user's SQLite WAL under
# /var/lib/encre; ReadOnlyPaths in deploy/litestream.service keeps that
# narrow). Fill in every value below before enabling litestream.service.
#
# B2 application key: create one scoped to a single bucket
# (https://www.backblaze.com/docs/cloud-storage-application-keys), never the
# account-wide master key — encre-qpx.4's whole point is that a leaked key
# alone must not be enough, and a bucket-scoped key is the first half of
# that even before age encryption is the second.

ENCRE_B2_BUCKET=
ENCRE_B2_ENDPOINT=
ENCRE_B2_KEY_ID=
ENCRE_B2_APPLICATION_KEY=

# The PUBLIC age recipient printed by `age-keygen` (deploy/litestream.yml's
# header comment) — safe to commit-adjacent, safe in this file. The SECRET
# identity that decrypts backups must never be in this file, this repo, or
# this VPS alone: see deploy/README.md, "Losing the age key".
ENCRE_LITESTREAM_AGE_RECIPIENT=
