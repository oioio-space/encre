coverage.out
coverage.html
junit.xml
sbom.cdx.json
bench-*.txt
*.prof

# Local-only
.env
.env.*
mise.local.toml
.idea/
# Traces de session des outils de navigateur (captures, logs de console).
.playwright-mcp/
.DS_Store

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
